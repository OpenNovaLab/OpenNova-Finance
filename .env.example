# Exemple de variables d'environnement — OpenNova-Finance
#
# Copier ce fichier en `.env.local` pour le développement, ou définir les
# variables dans Vercel (Settings → Environment Variables) en production.
# Ne jamais commiter de vraies valeurs : `.env*` est ignoré par git, sauf
# ce fichier d'exemple.

# --- Contrôle d'accès (protège toute l'application) ---

# Secret de signature des sessions d'accès. OBLIGATOIRE en production :
# sans lui, le middleware redirige tout vers /access?reason=config.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_SESSION_SECRET=

# Durée de vie d'une session, en minutes (défaut du code : 15).
ACCESS_SESSION_TTL_MINUTES=

# URL du service OpenNova-Access-Control et secret partagé de validation.
ACCESS_CONTROL_URL=
ACCESS_CONTROL_CLIENT_SECRET=

# Développement local seulement : contourne le contrôle d'accès.
# Ne JAMAIS mettre à "true" en production.
ACCESS_CONTROL_BYPASS=

# --- Pont local Hermes (phase 1, hébergement hybride) ---

# Activation des fonctions Hermes. À ne définir (true) que sur
# l'instance LOCALE (PC d'Alex, à côté de Hermes). Sur Vercel, laisser
# absent : les routes Hermes répondent proprement « désactivé » et la
# section Briefing Hermes affiche « instance locale seulement ».
HERMES_ENABLED=
# Même rôle côté navigateur ; figée au build — à définir avant
# `pnpm build` sur l'instance locale, absente sur Vercel.
NEXT_PUBLIC_HERMES_ENABLED=

# Clé de service du pont local Hermes (briefings + instantané).
# La même valeur doit être définie sur le PC qui exécute le pont
# (tools/hermes-bridge/). Minimum 16 caractères ; utiliser 64 hex.
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
HERMES_BRIDGE_KEY=

# --- Autres intégrations (selon les modules utilisés) ---

# Convex (fondation temps réel)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Données de marché Twelve Data
TWELVEDATA_API_KEY=
